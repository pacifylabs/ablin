# Public site URL, used for canonical URLs and structured data
SITE_URL=http://localhost:3000

# NestJS endpoint that stores contact enquiries and notifies the firm (built in a later phase).
# While unset, the contact form reports that it could not send; it never pretends to succeed.
CONTACT_API_URL=
# Optional bearer token the API expects from this site.
CONTACT_API_TOKEN=
