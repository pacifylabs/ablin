# Ablin website: environment variables.
#
# Local development: copy this file to `.env.local` and edit it (`.env.local` is git-ignored).
# Vercel: add the same keys under Project Settings > Environment Variables. Never commit real values.
# The site is a single Next.js project; there is no separate API. Most keys are read in src/lib/config.ts; the
# admin dashboard's (Redis, Cloudinary, Blob) are read directly where they're used — see each section below.

# --- Public site URL -------------------------------------------------------------------------------------------
# Full origin of the live site, used for canonical URLs, Open Graph and structured data.
# Must include the scheme: https://example.com (not example.com). No path.
#
# Local:   http://localhost:3000
# Vercel:  leave UNSET until the custom domain is live, then set Production to your canonical origin, e.g.
#          https://ablinlimited.com (must match the primary host you redirect to in Vercel Domains).
# A blank value is treated as unset. A non-empty value that is not a valid URL stops the build with a clear error.
SITE_URL=http://localhost:3000

# --- Public analytics (optional) -----------------------------------------------------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). The script loads only after a visitor accepts analytics
# in the cookie banner. Leave unset until the property is created and Search Console is linked in GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Contact form email delivery (Resend) ----------------------------------------------------------------------
# The route handler /api/contact emails each enquiry from the server. All three keys are required; if any is
# missing the form tells the visitor it could not send. It never pretends to succeed. Server-side only: never
# prefix these with NEXT_PUBLIC_.
#
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives enquiries, e.g. enquiries@your-domain
CONTACT_TO_EMAIL=
# Sender address on a domain you have verified in Resend, e.g. Ablin website <enquiries@your-domain>.
# For a first test you can use onboarding@resend.dev, which Resend only delivers to your own account email.
CONTACT_FROM_EMAIL=

# --- Admin CMS store (Upstash Redis) -----------------------------------------------------------------------
# The admin dashboard's entire data store — pages, Insights articles, submissions, settings, sessions.
#
# If you connected Upstash through Vercel's Marketplace integration, Vercel injects prefixed variable names
# instead of these two (e.g. "<store-name>_KV_REST_API_URL" / "..._KV_REST_API_TOKEN") — copy THEIR VALUES into
# THESE two names below; the app reads only these exact names. Use the *_KV_REST_API_TOKEN one (read-write),
# never *_KV_REST_API_READ_ONLY_TOKEN. The *_REDIS_URL / *_KV_URL ones are for TCP clients and are not used here.
#
# Without this, the public site still renders (from the bundled starting content — see cms/seed-data.ts) but
# the admin dashboard cannot start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin bootstrap account ---------------------------------------------------------------------------------
# Read only by `pnpm seed` (scripts/seed.ts), which creates or updates the single admin user. Not read by the
# running app — change the password afterwards from /admin/settings, not by re-running seed with a new value.
ADMIN_EMAIL=
# At least 12 characters.
ADMIN_PASSWORD=

# --- Admin image uploads (Cloudinary, signed server-side upload) --------------------------------------------
# Create a free account at https://cloudinary.com and copy these from its dashboard. The API secret never
# leaves the server (see src/admin/upload/cloudinary.ts) — the browser only ever talks to this Next.js app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin file uploads (Vercel Blob) -------------------------------------------------------------------------
# Non-image files linked from admin-edited rich text (e.g. a PDF). Create a Blob store under the Vercel
# project's Storage tab, which sets this automatically on Vercel; for local development, copy its token from
# there (its own "Quickstart" / ".env.local" tab, or Project Settings > Environment Variables — search "BLOB").
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# --- Contact form enquiry retention (Redis) ------------------------------------------------------------------
# Each submission:* key expires automatically after this many days (default 365). Deletes from /admin/submissions
# remove the record immediately. Server-side only.
SUBMISSION_RETENTION_DAYS=365

# --- Admin password reset email (Resend) ---------------------------------------------------------------------
# Uses the same RESEND_API_KEY as the contact form, above. Falls back to CONTACT_FROM_EMAIL when unset.
ADMIN_RESET_FROM_EMAIL=

# --- Provided automatically on Vercel: do not set --------------------------------------------------------------
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL
# Used as the fallback for SITE_URL when SITE_URL is unset.
